{
  "schema_version": "2.0.0",
  "project_name": "interview-video-objective-agent-v2",
  "architecture": {
    "mode": "hybrid_deterministic_weak_ai",
    "human_review_gate_enabled": true,
    "conservative_fallback_on_low_confidence": true,
    "max_ai_retries": 1,
    "notes": "Replaces v1 zero-tolerance blocking & 21-task bureaucracy with 6-stage deterministic kernel + 3 atomic weak-AI tasks + lightweight human review queue."
  },
  "time_model": {
    "canonical_unit": "microseconds",
    "interval_semantics": "half_open",
    "integer_only": true,
    "target_fps_num": 30,
    "target_fps_den": 1
  },
  "source_order": {
    "embedded_timestamp_patterns": [
      "(?P<date>20[0-9]{6})[_-]?(?P<time>[0-9]{6})",
      "(?P<date>20[0-9]{2}[-_][0-9]{2}[-_][0-9]{2})[_ -](?P<time>[0-9]{2}[-_:]?[0-9]{2}[-_:]?[0-9]{2})"
    ],
    "sequence_token_pattern": "(?:^|[_-])(?P<sequence>[0-9]{1,6})(?:[_-]|$)",
    "fallback_order": [
      "container_creation_time",
      "relative_path_lexicographic"
    ],
    "ignore_non_media_errors": true
  },
  "material_taxonomy": {
    "base_classes": [
      "company_scene",
      "person_scene",
      "interview_person"
    ],
    "special_roles": [
      "none",
      "intro_logo",
      "company_entrance",
      "hero_shot",
      "ending_slogan"
    ],
    "interview_detection": {
      "allow_solo_speaker_with_offmic_interviewer": true,
      "allow_last_source_as_interview": true,
      "minimum_speech_duration_us": 4000000
    }
  },
  "audio_processing": {
    "prefer_deepfilternet": true,
    "ffmpeg_fallback_filter": "highpass=f=80:poles=2,afftdn=nf=-25,loudnorm=I=-16:LRA=7:TP=-1.5",
    "ffmpeg_minimal_filter": "highpass=f=80:poles=2,loudnorm=I=-16:LRA=7:TP=-1.5",
    "target_sample_rate_hz": 48000,
    "target_channels": 2,
    "target_lufs": -16.0,
    "true_peak_dbtp": -1.5,
    "silence_threshold_db": -36.0,
    "min_silence_duration_sec": 0.45,
    "boundary_preroll_us": 120000,
    "boundary_tail_us": 180000,
    "qa_pause_handling": {
      "max_natural_pause_us": 800000,
      "trim_long_pause_to_us": 450000,
      "never_drop_exchange_for_thinking_pause": true
    },
    "word_level_hesitation_surgery": {
      "enabled": true,
      "filler_tokens": ["嗯", "啊", "呃", "那个", "就是说", "然后呢"],
      "mark_jump_cut_when_trimmed": true,
      "preserve_reversal_pause_us": 500000
    }
  },
  "weak_ai_guardrails": {
    "confidence_thresholds": {
      "auto_keep_min": 0.75,
      "auto_drop_min": 0.85,
      "review_band_behavior": "conservative_keep_and_flag"
    },
    "id_only_contract": true,
    "missing_segment_fallback": "keep_and_flag_review",
    "invalid_json_fallback": "deterministic_safe_plan"
  },
  "merged_version": {
    "version_id": "merged_interview_with_intro",
    "section_order": [
      "intro_logo",
      "company_entrance",
      "intro",
      "interview",
      "ending_slogan"
    ],
    "total_duration_us": {
      "min": 30000000,
      "target": 210000000,
      "max": 360000000
    },
    "golden_trio": {
      "enabled": true,
      "intro_logo_duration_us": 3000000,
      "company_entrance_duration_us": 4500000,
      "hero_shot_duration_us": 4500000,
      "allow_missing_optional_slots": true
    },
    "intro": {
      "target_duration_us": {
        "min": 30000000,
        "max": 90000000
      },
      "clip_duration_us": {
        "min": 3000000,
        "target": 5000000,
        "max": 7500000
      },
      "source_audio_muted": true,
      "voice_provider": "dual_track_manual_or_tts",
      "sentence_pause_us": 350000
    },
    "interview": {
      "preserve_exchange_order": true,
      "question_broll_forbidden": true,
      "answer_head_interview_us": 8000000,
      "answer_tail_interview_us": 3000000,
      "min_answer_for_broll_us": 14000000,
      "broll_clip_duration_us": {
        "min": 3500000,
        "target": 4800000,
        "max": 6000000
      },
      "target_broll_ratio": 0.25,
      "max_broll_ratio": 0.35
    },
    "ending_slogan": {
      "duration_us": 4500000,
      "allow_auto_title_card_fallback": true
    }
  },
  "ledger": {
    "no_source_overlap_within_version": true,
    "fallback_candidate_tiers": 3,
    "shortage_behavior": "fallback_to_interview_camera_or_lowest_used_scene_with_warning"
  },
  "subtitles": {
    "zero_punctuation": true,
    "forbid_mechanical_half_split": true,
    "max_chars_per_line": 18,
    "style": {
      "font_name": "Noto Sans CJK SC",
      "font_size": 52,
      "primary_colour_ass": "&H00FFFFFF",
      "outline_colour_ass": "&H00181818",
      "back_colour_ass": "&H80000000",
      "outline_px": 2.5,
      "shadow_px": 1.2,
      "margin_v": 58,
      "alignment": 2
    }
  },
  "render": {
    "width": 1920,
    "height": 1080,
    "fps_num": 30,
    "fps_den": 1,
    "prefer_nvenc": true,
    "cpu_fallback_encoder": "libx264",
    "video_bitrate": "12M",
    "audio_bitrate": "192k",
    "pixel_format": "yuv420p"
  }
}
